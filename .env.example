# Voids — example environment configuration.
#
# Copy to `.env` and adjust. `.env` is gitignored; this file (`.env.example`)
# contains placeholders ONLY — never commit real secrets.
#
# All values below are optional; the defaults shown are what the app uses when
# the variable is unset. App-level config (TMDB key, Jellyfin server, Radarr,
# notifications) is configured in the web UI and stored in the database — NOT
# here. These variables only control the process/runtime.

# --- HTTP server ---------------------------------------------------------------

# Listen port.
PORT=8484

# Persistent data directory (SQLite DB + generated TLS certs live here).
# In the Docker image this defaults to /data (a VOLUME). Locally it defaults
# to ./data.
DATA_DIR=/data

# Explicit SQLite database file path. Defaults to $DATA_DIR/voids.db.
# Usually leave this unset and let DATA_DIR drive it.
# DATABASE_PATH=/data/voids.db

# Sub-path mount point, for serving behind a reverse proxy at a sub-path
# (e.g. https://host/voids). Default is "/". Include a leading slash.
BASE_URL=/

# --- Authentication ------------------------------------------------------------

# Auth mode for the API + web UI: `none` (open, default — for trusted LANs)
# or `basic` (HTTP Basic auth). The /rss/** feed endpoints stay public even in
# basic mode so Radarr can poll them.
AUTH_MODE=none

# Basic-auth username (only used when AUTH_MODE=basic). Default: admin.
AUTH_USERNAME=admin

# Basic-auth password (only used when AUTH_MODE=basic). Plaintext here; hashed
# on boot and never logged. If AUTH_MODE=basic and this is unset, the server
# fails closed (denies all) with a warning. Use a real, strong value.
# AUTH_PASSWORD=change-me

# --- TLS -----------------------------------------------------------------------

# TLS mode: `off` (plain HTTP, default — terminate TLS at a reverse proxy) or
# `on` (server generates a fresh self-signed cert into $DATA_DIR/tls on first
# boot and serves HTTPS directly).
TLS=off

# --- TMDB tuning ---------------------------------------------------------------

# TMDB token-bucket sustained rate, in requests/second. Default 40 (well under
# TMDB's limit). The TMDB API *key* itself is configured in the UI, not here.
TMDB_RATE_LIMIT=40

# --- Logging -------------------------------------------------------------------

# Log level (Nest/Pino style): error | warn | log | debug | verbose.
# Default: log. Secrets are always redacted regardless of level.
LOG_LEVEL=log
