{
  "name": "@voids/server",
  "version": "0.1.0",
  "private": true,
  "description": "@voids/server — NestJS API and static host for the Voids web app.",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "pnpm --filter @voids/shared build",
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "pretypecheck": "pnpm --filter @voids/shared build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.6",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.6",
    "@nestjs/platform-express": "^11.0.6",
    "@nestjs/platform-ws": "^11.1.26",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.3",
    "@nestjs/websockets": "^11.1.26",
    "@voids/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.8.1",
    "cron": "^4.4.0",
    "drizzle-orm": "^0.39.1",
    "nestjs-zod": "^4.3.1",
    "nodemailer": "^8.0.11",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "selfsigned": "^5.5.0",
    "ws": "^8.21.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.2",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.6",
    "@swc/core": "^1.10.16",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.30.4",
    "supertest": "^7.0.0",
    "typescript": "^5.7.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.0.5"
  }
}
