{
  "name": "@voids/shared",
  "version": "0.2.0",
  "private": true,
  "description": "Shared zod schemas and types — the contract between @voids/server and @voids/web.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
